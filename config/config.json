  "portals": {
    "all": {
      "sources": [
        "hasjob",
        "shine",
        "internshala",
        "ycombinator",
        "himalayas",
        "python-jobs",
        "remoteok",
        "workingnomads"
      ]
    },
    "shine": {
      "search_url": "https://www.shine.com/job-search/{query}-jobs-in-india",
      "default_query": "software",
      "max_pages": 2
    },
    "internshala": {
      "base_url": "https://internshala.com/jobs/",
      "max_pages": 2
    },
    "ycombinator": {
      "base_url": "https://www.ycombinator.com/jobs/location/india",
      "max_pages": 1
    },
    "hasjob": {
      "base_url": "https://hasjob.co/feed"
    },
    "himalayas": {
      "base_url": "https://himalayas.app/jobs/api",
      "countries": [
        "India"
      ],
      "max_pages": 60,
      "page_size": 20
    },
    "arbeitnow": {
      "base_url": "https://www.arbeitnow.com/api/job-board-api",
      "max_pages": 3
    },
    "jobicy": {
      "base_url": "https://jobicy.com/api/jobs",
      "max_pages": 2
    },
    "remoteok": {
      "base_url": "https://remoteok.com/api"
    },
    "workingnomads": {
      "base_url": "https://www.workingnomads.com/api/exposed_jobs/"
    },
    "weworkremotely": {
      "feeds": [
        "https://weworkremotely.com/categories/remote-programming-jobs.rss",
        "https://weworkremotely.com/categories/remote-devops-sysadmin-jobs.rss",
        "https://weworkremotely.com/categories/remote-design-jobs.rss"
      ]
    },
    "python-jobs": {
      "base_url": "https://www.python.org/jobs/",
      "max_pages": 1,
      "selectors": {
        "card": "ol.list-recent-jobs > li",
        "title": "h2.listing-company a",
        "company_name": ".listing-company-name",
        "location": ".listing-location",
        "date": "time",
        "types": ".listing-job-type a",
        "category": ".listing-company-category a",
        "detail_description": "div.job-description",
        "detail_apply_link": "a[href^='http']"
      }
    }
  }
